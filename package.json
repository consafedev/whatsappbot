{
  "name": "whatsapp-automation-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "db:generate": "pnpm --filter @whatsapp-platform/database db:generate",
    "db:migrate:deploy": "pnpm --filter @whatsapp-platform/database db:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @whatsapp-platform/database db:migrate:dev",
    "db:studio": "pnpm --filter @whatsapp-platform/database db:studio",
    "db:validate": "pnpm --filter @whatsapp-platform/database db:validate",
    "lint": "biome lint .",
    "platform-admin:create": "pnpm --filter @whatsapp-platform/api platform-admin:create",
    "rbac:sync-permissions": "pnpm --filter @whatsapp-platform/database rbac:sync-permissions",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:integration:database": "pnpm --filter @whatsapp-platform/database test:integration",
    "test:integration:auth": "pnpm --filter @whatsapp-platform/api test:integration",
    "test:integration:rbac": "pnpm --filter @whatsapp-platform/database test:integration:rbac && pnpm --filter @whatsapp-platform/api test:integration:rbac",
    "test:integration:platform-tenants": "pnpm --filter @whatsapp-platform/database test:integration:platform-tenants && pnpm --filter @whatsapp-platform/api test:integration:platform-tenants",
    "test:integration:platform-tenant-detail": "pnpm --filter @whatsapp-platform/database test:integration:platform-tenant-detail && pnpm --filter @whatsapp-platform/api test:integration:platform-tenant-detail",
    "test:integration:tenant-provisioning": "pnpm --filter @whatsapp-platform/database test:integration:tenant-provisioning && pnpm --filter @whatsapp-platform/api test:integration:tenant-provisioning",
    "test:integration:entitlements": "pnpm --filter @whatsapp-platform/database test:integration:entitlements && pnpm --filter @whatsapp-platform/api test:integration:entitlements",
    "test:integration:tenant-status": "pnpm --filter @whatsapp-platform/database test:integration:tenant-status && pnpm --filter @whatsapp-platform/api test:integration:tenant-status",
    "test:integration:tenant-app-bootstrap": "pnpm --filter @whatsapp-platform/api test:integration:tenant-app-bootstrap",
    "test:integration:theme-engine": "pnpm --filter @whatsapp-platform/database test:integration:theme-engine && pnpm --filter @whatsapp-platform/api test:integration:theme-engine",
    "test:integration:organization-units": "pnpm --filter @whatsapp-platform/database test:integration:organization-units && pnpm --filter @whatsapp-platform/api test:integration:organization-units",
    "test:integration:user-management": "pnpm --filter @whatsapp-platform/database test:integration:user-management && pnpm --filter @whatsapp-platform/api test:integration:user-management",
    "test:integration:channel-accounts": "pnpm --filter @whatsapp-platform/database test:integration:channel-accounts && pnpm --filter @whatsapp-platform/api test:integration:channel-accounts",
    "test:integration:contacts": "pnpm --filter @whatsapp-platform/database test:integration:contacts && pnpm --filter @whatsapp-platform/api test:integration:contacts",
    "test:integration:conversations": "pnpm --filter @whatsapp-platform/database test:integration:conversations",
    "test:integration:inbox-query": "pnpm --filter @whatsapp-platform/database test:integration:inbox-query && pnpm --filter @whatsapp-platform/api test:integration:inbox",
    "test:integration:inbox-mutation": "pnpm --filter @whatsapp-platform/database test:integration:inbox-mutation && pnpm --filter @whatsapp-platform/api test:integration:inbox",
    "test:integration:inbound-messages": "pnpm --filter @whatsapp-platform/database test:integration:inbound-messages",
    "test:integration:outbound-conversation-messages": "pnpm --filter @whatsapp-platform/database test:integration:outbound-conversation-messages",
    "test:integration:outbound-echo": "pnpm --filter @whatsapp-platform/database test:integration:outbound-echo",
    "test:integration:external-human-messages": "pnpm --filter @whatsapp-platform/database test:integration:external-human-messages",
    "test:integration:inbound-webhooks": "pnpm --filter @whatsapp-platform/database test:integration:inbound-webhooks && pnpm --filter @whatsapp-platform/api test:integration:inbound-webhooks",
    "test:integration:rules": "pnpm --filter @whatsapp-platform/database test:integration:rules && pnpm --filter @whatsapp-platform/api test:integration:rules",
    "test:integration:ai-gateway": "pnpm --filter @whatsapp-platform/database test:integration:ai-gateway && pnpm --filter @whatsapp-platform/api test:integration:ai-gateway",
    "test:integration:takeover": "pnpm --filter @whatsapp-platform/database test:integration:takeover",
    "test:integration:assignment-policies": "pnpm --filter @whatsapp-platform/database test:integration:assignment-policies",
    "test:security:tenant-isolation": "pnpm --filter @whatsapp-platform/database test:security:tenant-isolation && pnpm --filter @whatsapp-platform/api test:security:tenant-isolation",
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.13.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

}

model Quote {
  id                         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId                   String       @map("tenant_id") @db.Uuid
  organizationUnitId         String       @map("organization_unit_id") @db.Uuid
  contactId                  String       @map("contact_id") @db.Uuid
  createdByUserId            String       @map("created_by_user_id") @db.Uuid
  numberSequence             BigInt       @map("number_sequence")
  number                     String       @db.VarChar(12)
  status                     String       @default("draft") @db.VarChar(32)
  revision                   Int          @default(1)
  autonomyLevel              Int          @default(0) @map("autonomy_level")
  currency                   String       @db.VarChar(3)
  currencyPrecision          Int          @map("currency_precision")
  validUntil                 DateTime?    @map("valid_until") @db.Timestamptz(3)
  terms                      String?      @db.VarChar(8000)
  notes                      String?      @db.VarChar(4000)
  shippingTotal              Decimal      @default(0) @map("shipping_total") @db.Decimal(19, 4)
  subtotal                   Decimal?     @db.Decimal(24, 4)
  discountTotal              Decimal?     @map("discount_total") @db.Decimal(24, 4)
  taxTotal                   Decimal?     @map("tax_total") @db.Decimal(24, 4)
  total                      Decimal?     @db.Decimal(24, 4)
  calculatedRevision         Int?          @map("calculated_revision")
  calculationInputHash       String?       @map("calculation_input_hash") @db.Char(64)
  customerNameSnapshot       String       @map("customer_name_snapshot") @db.VarChar(150)
  customerPhoneSnapshot      String       @map("customer_phone_snapshot") @db.VarChar(64)
  organizationUnitNameSnapshot String    @map("organization_unit_name_snapshot") @db.VarChar(150)
  salespersonNameSnapshot    String       @map("salesperson_name_snapshot") @db.VarChar(150)
  createdAt                  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "quotes_tenant_fkey")
  organizationUnit OrganizationUnit           @relation(fields: [tenantId, organizationUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "quotes_organization_unit_fkey")
  contact          Contact                    @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "quotes_contact_fkey")
  createdBy        User                       @relation("QuoteCreator", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "quotes_creator_fkey")
  items            QuoteItem[]
  receipts         QuoteCommandReceipt[]
  contributors     QuoteCommercialContributor[]

  @@unique([tenantId, id], map: "quotes_tenant_id_id_key")
  @@unique([tenantId, numberSequence], map: "quotes_tenant_number_sequence_key")
  @@unique([tenantId, number], map: "quotes_tenant_number_key")
  @@index([tenantId, status, createdAt, id], map: "quotes_tenant_status_created_idx")
  @@index([tenantId, contactId, createdAt], map: "quotes_tenant_contact_created_idx")
  @@map("quotes")
}

model QuoteItem {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  quoteId        String   @map("quote_id") @db.Uuid
  position       Int
  productId      String?  @map("product_id") @db.Uuid
  source         String   @db.VarChar(16)
  sku            String?  @db.VarChar(64)
  description    String   @db.VarChar(2000)
  unit           String   @db.VarChar(32)
  quantity       Decimal  @db.Decimal(9, 3)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(19, 4)
  currency       String   @db.VarChar(3)
  taxCode        String?  @map("tax_code") @db.VarChar(64)
  taxRate        Decimal? @map("tax_rate") @db.Decimal(9, 4)
  discountKind   String   @default("fixed") @map("discount_kind") @db.VarChar(16)
  discountValue  Decimal  @default(0) @map("discount_value") @db.Decimal(19, 4)
  grossTotal     Decimal? @map("gross_total") @db.Decimal(24, 4)
  discountTotal  Decimal? @map("discount_total") @db.Decimal(24, 4)
  netTotal       Decimal? @map("net_total") @db.Decimal(24, 4)
  taxTotal       Decimal? @map("tax_total") @db.Decimal(24, 4)
  lineTotal      Decimal? @map("line_total") @db.Decimal(24, 4)
  isExceptional  Boolean  @default(false) @map("is_exceptional")
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "quote_items_tenant_fkey")
  quote   Quote   @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "quote_items_quote_fkey")
  product Product? @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "quote_items_product_fkey")

  @@unique([tenantId, id], map: "quote_items_tenant_id_id_key")
  @@unique([tenantId, quoteId, position], map: "quote_items_tenant_quote_position_key")
  @@index([tenantId, quoteId, position], map: "quote_items_tenant_quote_position_idx")
  @@index([tenantId, productId], map: "quote_items_tenant_product_idx")
  @@map("quote_items")
}

model QuoteCommandReceipt {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  resourceId      String   @map("resource_id") @db.Uuid
  quoteId         String?  @map("quote_id") @db.Uuid
  actorUserId     String   @map("actor_user_id") @db.Uuid
  idempotencyKey  String   @map("idempotency_key") @db.VarChar(128)
  commandType     String   @map("command_type") @db.VarChar(32)
  requestHash     String   @map("request_hash") @db.Char(64)
  recordedOutcome Json     @map("recorded_outcome") @db.JsonB
  recordedAt      DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "quote_command_receipts_tenant_fkey")
  quote  Quote? @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "quote_command_receipts_quote_fkey")
  actor  User   @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "quote_command_receipts_actor_fkey")

  @@unique([tenantId, id], map: "quote_command_receipts_tenant_id_id_key")
  @@unique([tenantId, idempotencyKey], map: "quote_command_receipts_tenant_key_key")
  @@index([tenantId, resourceId, recordedAt], map: "quote_command_receipts_tenant_resource_recorded_idx")
  @@map("quote_command_receipts")
}

model QuoteCommercialContributor {
  tenantId           String   @map("tenant_id") @db.Uuid
  quoteId            String   @map("quote_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  firstContributedAt DateTime @default(now()) @map("first_contributed_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "quote_commercial_contributors_tenant_fkey")
  quote  Quote  @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "quote_commercial_contributors_quote_fkey")
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade, map: "quote_commercial_contributors_user_fkey")

  @@id([tenantId, quoteId, userId], map: "quote_commercial_contributors_pkey")
  @@index([tenantId, userId, firstContributedAt], map: "quote_commercial_contributors_tenant_user_idx")
  @@map("quote_commercial_contributors")
}

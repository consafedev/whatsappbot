generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformDeploymentMode {
  shared
  dedicated
  customer_hosted

  @@map("platform_deployment_mode")
}

enum DeploymentEnvironment {
  production
  staging
  development

  @@map("deployment_environment")
}

enum ReleaseChannel {
  stable
  candidate
  beta

  @@map("release_channel")
}

enum PlatformDeploymentStatus {
  healthy
  degraded
  offline
  maintenance

  @@map("platform_deployment_status")
}

enum TenantStatus {
  provisioning
  active
  suspended
  offboarding
  archived

  @@map("tenant_status")
}

enum TenantEntitlementSource {
  plan
  manual_override
  trial
  contract

  @@map("tenant_entitlement_source")
}

enum OrganizationUnitType {
  company
  branch
  department
  team
  other

  @@map("organization_unit_type")
}

enum PlatformAdminStatus {
  active
  disabled

  @@map("platform_admin_status")
}

enum PlatformAdminMfaState {
  disabled
  enabled

  @@map("platform_admin_mfa_state")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

enum UserMfaState {
  disabled
  enabled

  @@map("user_mfa_state")
}

model PlatformDeployment {
  id             String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  mode           PlatformDeploymentMode
  environment    DeploymentEnvironment
  currentVersion String                   @map("current_version")
  targetVersion  String?                  @map("target_version")
  releaseChannel ReleaseChannel           @map("release_channel")
  status         PlatformDeploymentStatus
  baseUrl        String?                  @map("base_url")
  metadata       Json?                    @db.JsonB
  lastHealthAt   DateTime?                @map("last_health_at") @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenants        Tenant[]

  @@map("platform_deployment")
}

model PlatformAdmin {
  id           String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String                 @unique(map: "platform_admin_email_key")
  passwordHash String                 @map("password_hash")
  displayName  String                 @map("display_name")
  status       PlatformAdminStatus    @default(active)
  locale       String
  timezone     String
  lastLoginAt  DateTime?              @map("last_login_at") @db.Timestamptz(3)
  mfaState     PlatformAdminMfaState  @default(disabled) @map("mfa_state")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     PlatformAdminSession[]

  @@index([status], map: "platform_admin_status_idx")
  @@map("platform_admin")
}

model PlatformAdminSession {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  platformAdminId String        @map("platform_admin_id") @db.Uuid
  tokenHash       Bytes         @unique(map: "platform_admin_session_token_hash_key") @map("token_hash")
  deviceLabel     String?       @map("device_label")
  ipHash          Bytes?        @map("ip_hash")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt      DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(3)
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([platformAdminId], map: "platform_admin_session_admin_id_idx")
  @@index([expiresAt], map: "platform_admin_session_expires_at_idx")
  @@map("platform_admin_session")
}

model Tenant {
  id                  String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deploymentId        String?                  @map("deployment_id") @db.Uuid
  legalName           String                   @map("legal_name")
  displayName         String                   @map("display_name")
  slug                String                   @unique(map: "tenant_slug_key")
  status              TenantStatus
  defaultTimezone     String                   @map("default_timezone")
  defaultLocale       String                   @map("default_locale")
  defaultCurrency     String                   @map("default_currency")
  brandingConfig      Json                     @default("{}") @map("branding_config") @db.JsonB
  settings            Json                     @default("{}") @db.JsonB
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  suspendedAt         DateTime?                @map("suspended_at") @db.Timestamptz(3)
  deployment          PlatformDeployment?      @relation(fields: [deploymentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  entitlements        TenantEntitlement[]
  organizationUnits   OrganizationUnit[]
  domainEvents        DomainEventOutbox[]
  auditLogs           AuditLog[]
  users               User[]
  userSessions        UserSession[]
  passwordResetTokens UserPasswordResetToken[]
  roles               Role[]
  userRoles           UserRole[]
  channelAccounts     ChannelAccount[]
  inboundMessageEvents InboundMessageEvent[]
  outboundMessages    OutboundMessage[]
  contacts             Contact[]
  conversations       Conversation[]
  messages            Message[]
  rules               Rule[]

  @@index([status], map: "tenant_status_idx")
  @@index([deploymentId], map: "tenant_deployment_id_idx")
  @@map("tenant")
}

model User {
  id                  String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId            String                   @map("tenant_id") @db.Uuid
  email               String
  passwordHash        String                   @map("password_hash")
  displayName         String                   @map("display_name")
  status              UserStatus               @default(active)
  locale              String
  timezone            String
  lastLoginAt         DateTime?                @map("last_login_at") @db.Timestamptz(3)
  mfaState            UserMfaState             @default(disabled) @map("mfa_state")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions            UserSession[]
  passwordResetTokens UserPasswordResetToken[]
  roleAssignments     UserRole[]
  outboundMessages    OutboundMessage[]
  assignedConversations Conversation[] @relation("ConversationAssignedUser")

  @@unique([tenantId, email], map: "tenant_user_tenant_email_key")
  @@unique([tenantId, id], map: "tenant_user_tenant_id_id_key")
  @@index([tenantId, status], map: "tenant_user_tenant_status_idx")
  @@map("tenant_user")
}

model UserSession {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   Bytes     @unique(map: "user_session_token_hash_key") @map("token_hash")
  deviceLabel String?   @map("device_label")
  ipHash      Bytes?    @map("ip_hash")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, userId], map: "user_session_tenant_user_idx")
  @@index([expiresAt], map: "user_session_expires_at_idx")
  @@map("user_session")
}

model UserPasswordResetToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  Bytes     @unique(map: "user_password_reset_token_hash_key") @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user       User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, userId], map: "user_password_reset_tenant_user_idx")
  @@index([expiresAt], map: "user_password_reset_expires_at_idx")
  @@map("user_password_reset_token")
}

model Role {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String?          @map("tenant_id") @db.Uuid
  name            String
  key             String
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permissions     RolePermission[]
  userAssignments UserRole[]

  @@unique([tenantId, key], map: "role_tenant_key_key")
  @@unique([tenantId, id], map: "role_tenant_id_id_key")
  @@index([tenantId], map: "role_tenant_id_idx")
  @@map("role")
}

model Permission {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key             String           @unique(map: "permission_key_key")
  description     String
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  roleAssignments RolePermission[]

  @@map("permission")
}

model UserRole {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  roleId             String            @map("role_id") @db.Uuid
  organizationUnitId String?           @map("organization_unit_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user               User              @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  role               Role              @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  organizationUnit   OrganizationUnit? @relation(fields: [tenantId, organizationUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, userId, roleId, organizationUnitId], map: "user_role_assignment_key")
  @@index([tenantId, userId], map: "user_role_tenant_user_idx")
  @@index([tenantId, roleId], map: "user_role_tenant_role_idx")
  @@index([organizationUnitId], map: "user_role_organization_unit_id_idx")
  @@map("user_role")
}

model RolePermission {
  roleId           String     @map("role_id") @db.Uuid
  permissionId     String     @map("permission_id") @db.Uuid
  scopeConstraints Json?      @map("scope_constraints") @db.JsonB
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  role             Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission       Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permission_permission_id_idx")
  @@map("role_permission")
}

model AuditLog {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String?           @map("tenant_id") @db.Uuid
  actorType          String            @map("actor_type")
  actorId            String?           @map("actor_id")
  action             String
  entityType         String            @map("entity_type")
  entityId           String            @map("entity_id")
  organizationUnitId String?           @map("organization_unit_id") @db.Uuid
  beforeSummary      Json?             @map("before_summary") @db.JsonB
  afterSummary       Json?             @map("after_summary") @db.JsonB
  requestId          String            @map("request_id")
  ipMetadata         Json?             @map("ip_metadata") @db.JsonB
  occurredAt         DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organizationUnit   OrganizationUnit? @relation(fields: [tenantId, organizationUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId, occurredAt], map: "audit_log_tenant_occurred_at_idx")
  @@index([entityType, entityId, occurredAt], map: "audit_log_entity_occurred_at_idx")
  @@index([requestId], map: "audit_log_request_id_idx")
  @@map("audit_log")
}

model DomainEventOutbox {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json      @db.JsonB
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId], map: "domain_event_outbox_tenant_id_idx")
  @@index([publishedAt, occurredAt], map: "domain_event_outbox_pending_idx")
  @@index([aggregateType, aggregateId], map: "domain_event_outbox_aggregate_idx")
  @@map("domain_event_outbox")
}

model TenantEntitlement {
  id             String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                  @map("tenant_id") @db.Uuid
  entitlementKey String                  @map("entitlement_key")
  enabled        Boolean                 @default(false)
  limitValue     Decimal?                @map("limit_value") @db.Decimal(20, 4)
  config         Json                    @default("{}") @db.JsonB
  startsAt       DateTime?               @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?               @map("ends_at") @db.Timestamptz(3)
  source         TenantEntitlementSource
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, entitlementKey], map: "tenant_entitlement_tenant_key_key")
  @@index([tenantId], map: "tenant_entitlement_tenant_id_idx")
  @@map("tenant_entitlement")
}

model PlatformFeatureFlag {
  key             String   @id
  enabledGlobally Boolean  @default(false) @map("enabled_globally")
  rolloutConfig   Json     @default("{}") @map("rollout_config") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_feature_flag")
}

model OrganizationUnit {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  parentId        String?              @map("parent_id") @db.Uuid
  type            OrganizationUnitType
  name            String
  code            String?
  timezone        String?
  businessHoursId String?              @map("business_hours_id") @db.Uuid
  address         Json?                @db.JsonB
  settings        Json                 @default("{}") @db.JsonB
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent          OrganizationUnit?    @relation("OrganizationUnitHierarchy", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  children        OrganizationUnit[]   @relation("OrganizationUnitHierarchy")
  auditLogs       AuditLog[]
  userRoles       UserRole[]
  channelAccounts ChannelAccount[]
  assignedConversations Conversation[] @relation("ConversationAssignedUnit")
  rules           Rule[]

  @@unique([tenantId, id], map: "organization_unit_tenant_id_id_key")
  @@index([tenantId], map: "organization_unit_tenant_id_idx")
  @@index([parentId], map: "organization_unit_parent_id_idx")
  @@index([tenantId, active], map: "organization_unit_tenant_active_idx")
  @@map("organization_unit")
}

model ChannelAccount {
  id                    String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  organizationUnitId    String?           @map("organization_unit_id") @db.Uuid
  channelType           String            @default("whatsapp") @map("channel_type")
  providerType          String            @map("provider_type")
  displayName           String            @map("display_name")
  externalAccountId     String?           @map("external_account_id")
  phoneNumber           String?           @map("phone_number")
  phoneNumberUniqueKey  String?           @map("phone_number_unique_key")
  status                String            @default("disconnected")
  automationDefaultMode String?          @map("automation_default_mode")
  credentialsCiphertext String?          @map("credentials_ciphertext")
  credentialsKeyVersion Int?             @map("credentials_key_version")
  providerConfig        Json?             @map("provider_config") @db.JsonB
  settings              Json              @default("{}") @db.JsonB
  lastConnectedAt       DateTime?         @map("last_connected_at") @db.Timestamptz(3)
  lastDisconnectedAt    DateTime?         @map("last_disconnected_at") @db.Timestamptz(3)
  lastErrorCode         String?           @map("last_error_code")
  lastErrorAt           DateTime?         @map("last_error_at") @db.Timestamptz(3)
  healthStatus          String?           @map("health_status")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  active                Boolean           @default(true)
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organizationUnit      OrganizationUnit? @relation(fields: [tenantId, organizationUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  inboundMessageEvents  InboundMessageEvent[]
  outboundMessages      OutboundMessage[]
  conversations         Conversation[]
  messages              Message[]
  rules                 Rule[]

  @@unique([tenantId, id], map: "channel_account_tenant_id_id_key")
  @@unique([tenantId, phoneNumberUniqueKey], map: "channel_account_tenant_phone_active_key")
  @@index([tenantId], map: "channel_account_tenant_id_idx")
  @@index([tenantId, status], map: "channel_account_tenant_status_idx")
  @@map("channel_account")
}

model InboundMessageEvent {
  id                 String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  channelAccountId   String         @map("channel_account_id") @db.Uuid
  providerMessageId  String?        @map("provider_message_id")
  eventType          String         @default("MESSAGE_RECEIVED") @map("event_type")
  senderPhone        String?        @map("sender_phone")
  recipientPhone     String?        @map("recipient_phone")
  messageType        String?        @map("message_type")
  payload            Json           @db.JsonB
  normalizedData     Json?          @map("normalized_data") @db.JsonB
  processedStatus    String         @default("PENDING") @map("processed_status")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt        DateTime?      @map("processed_at") @db.Timestamptz(3)
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  channelAccount     ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  messages           Message[]

  @@index([tenantId, channelAccountId], map: "inbound_message_event_tenant_channel_idx")
  @@index([tenantId, processedStatus], map: "inbound_message_event_tenant_status_idx")
  @@unique([tenantId, channelAccountId, providerMessageId], map: "inbound_message_event_provider_message_key")
  @@unique([tenantId, id], map: "inbound_message_event_tenant_id_key")
  @@map("inbound_message_event")
}

model OutboundMessage {
  id                String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  channelAccountId  String          @map("channel_account_id") @db.Uuid
  actorUserId       String?         @map("actor_user_id") @db.Uuid
  idempotencyKey    String          @map("idempotency_key")
  recipientPhone    String          @map("recipient_phone")
  messageType       String          @default("text") @map("message_type")
  content           Json            @db.JsonB
  status            String          @default("PENDING")
  retryCount        Int             @default(0) @map("retry_count")
  maxRetries        Int             @default(3) @map("max_retries")
  providerMessageId String?         @map("provider_message_id")
  lastError         String?         @map("last_error")
  scheduledAt       DateTime?       @map("scheduled_at") @db.Timestamptz(3)
  sentAt            DateTime?       @map("sent_at") @db.Timestamptz(3)
  failedAt          DateTime?       @map("failed_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  channelAccount    ChannelAccount  @relation(fields: [channelAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser         User?           @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  message           Message?        @relation("OutboundCanonicalMessage")

  @@unique([tenantId, id], map: "outbound_message_tenant_id_key")
  @@unique([tenantId, idempotencyKey], map: "outbound_message_tenant_idempotency_key")
  @@index([tenantId, channelAccountId], map: "outbound_message_tenant_channel_idx")
  @@index([tenantId, status], map: "outbound_message_tenant_status_idx")
  @@index([status, scheduledAt], map: "outbound_message_status_scheduled_idx")
  @@index([tenantId, recipientPhone], map: "outbound_message_tenant_recipient_idx")
  @@index([tenantId, actorUserId], map: "outbound_message_tenant_actor_idx")
  @@map("outbound_message")
}

model Contact {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  name             String    @default("Sin Nombre")
  phoneNumber      String    @map("phone_number")
  email            String?
  avatarUrl        String?   @map("avatar_url")
  status           String    @default("ACTIVE")
  tags             String[]  @default([])
  customAttributes Json?     @map("custom_attributes") @db.JsonB
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  conversations    Conversation[]
  messages         Message[]

  @@unique([tenantId, id], map: "contact_tenant_id_id_key")
  @@unique([tenantId, phoneNumber], map: "contact_tenant_phone_number_key")
  @@index([tenantId], map: "contact_tenant_id_idx")
  @@index([tenantId, status], map: "contact_tenant_status_idx")
  @@index([tenantId, name], map: "contact_tenant_name_idx")
  @@map("contact")
}

model Conversation {
  id                    String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  channelAccountId      String            @map("channel_account_id") @db.Uuid
  contactId             String            @map("contact_id") @db.Uuid
  status                String            @default("open")
  automationMode        String            @default("AUTO") @map("automation_mode")
  assignedUserId        String?           @map("assigned_user_id") @db.Uuid
  assignedUnitId        String?           @map("assigned_unit_id") @db.Uuid
  priority              Int               @default(0)
  subject               String?
  providerThreadId      String?           @map("provider_thread_id")
  lastMessageAt         DateTime?         @map("last_message_at") @db.Timestamptz(3)
  lastInboundAt         DateTime?         @map("last_inbound_at") @db.Timestamptz(3)
  lastOutboundAt        DateTime?         @map("last_outbound_at") @db.Timestamptz(3)
  lastHumanMessageAt    DateTime?         @map("last_human_message_at") @db.Timestamptz(3)
  lastAutomationMessageAt DateTime?      @map("last_automation_message_at") @db.Timestamptz(3)
  humanTakeoverUntil    DateTime?         @map("human_takeover_until") @db.Timestamptz(3)
  closedAt              DateTime?         @map("closed_at") @db.Timestamptz(3)
  metadata              Json?             @db.JsonB
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  channelAccount        ChannelAccount    @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  contact               Contact           @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedUser          User?             @relation("ConversationAssignedUser", fields: [tenantId, assignedUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedUnit          OrganizationUnit? @relation("ConversationAssignedUnit", fields: [tenantId, assignedUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  messages              Message[]

  @@unique([tenantId, id], map: "conversation_tenant_id_id_key")
  @@index([tenantId, status, lastMessageAt], map: "conversation_tenant_status_last_message_idx")
  @@index([tenantId, contactId], map: "conversation_tenant_contact_idx")
  @@index([tenantId, channelAccountId], map: "conversation_tenant_channel_idx")
  @@index([tenantId, assignedUserId], map: "conversation_tenant_assigned_user_idx")
  @@index([tenantId, assignedUnitId], map: "conversation_tenant_assigned_unit_idx")
  @@index([tenantId, channelAccountId, contactId, status], map: "conversation_tenant_resolution_idx")
  @@map("conversation")
}

model Message {
  id                 String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  conversationId     String               @map("conversation_id") @db.Uuid
  channelAccountId   String               @map("channel_account_id") @db.Uuid
  contactId          String?              @map("contact_id") @db.Uuid
  direction          String
  origin             String
  actorType          String               @map("actor_type")
  actorId            String?              @map("actor_id")
  providerMessageId  String?              @map("provider_message_id")
  providerTimestamp  DateTime?            @map("provider_timestamp") @db.Timestamptz(3)
  messageType        String               @map("message_type")
  textBody           String?              @map("text_body")
  structuredPayload  Json?                @map("structured_payload") @db.JsonB
  replyToMessageId   String?              @map("reply_to_message_id") @db.Uuid
  deliveryStatus     String               @default("received") @map("delivery_status")
  idempotencyKey     String?              @map("idempotency_key")
  inboundEventId     String?              @map("inbound_event_id") @db.Uuid
  outboundMessageId  String?              @map("outbound_message_id") @db.Uuid
  metadata           Json?                @db.JsonB
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  conversation       Conversation         @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  channelAccount     ChannelAccount       @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  contact            Contact?             @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  inboundEvent       InboundMessageEvent? @relation(fields: [tenantId, inboundEventId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  outboundMessage    OutboundMessage?     @relation("OutboundCanonicalMessage", fields: [tenantId, outboundMessageId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  replyTo            Message?             @relation("MessageReplies", fields: [tenantId, replyToMessageId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  replies            Message[]            @relation("MessageReplies")

  @@unique([tenantId, id], map: "message_tenant_id_key")
  @@unique([tenantId, channelAccountId, providerMessageId], map: "message_provider_identity_key")
  @@unique([tenantId, inboundEventId], map: "message_tenant_inbound_event_key")
  @@unique([tenantId, idempotencyKey], map: "message_tenant_idempotency_key")
  @@unique([tenantId, outboundMessageId], map: "message_tenant_outbound_message_key")
  @@index([tenantId, conversationId, createdAt], map: "message_tenant_conversation_created_idx")
  @@index([tenantId, providerMessageId], map: "message_tenant_provider_message_idx")
  @@index([tenantId, inboundEventId], map: "message_tenant_inbound_event_idx")
  @@index([tenantId, outboundMessageId], map: "message_tenant_outbound_message_idx")
  @@map("message")
}

model Rule {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  name               String
  description        String?
  triggerType        String            @map("trigger_type")
  priority           Int               @default(100)
  status             String            @default("draft")
  executionMode      String            @default("first_match_stop") @map("execution_mode")
  conditions         Json              @db.JsonB
  actions            Json              @db.JsonB
  cooldownSeconds    Int               @default(0) @map("cooldown_seconds")
  channelAccountId   String?           @map("channel_account_id") @db.Uuid
  organizationUnitId String?           @map("organization_unit_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  channelAccount     ChannelAccount?   @relation(fields: [tenantId, channelAccountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  organizationUnit   OrganizationUnit? @relation(fields: [tenantId, organizationUnitId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id], map: "rule_tenant_id_key")
  @@index([tenantId, status, triggerType, priority], map: "rule_tenant_status_trigger_priority_idx")
  @@index([tenantId, channelAccountId], map: "rule_tenant_channel_account_idx")
  @@map("rule")
}

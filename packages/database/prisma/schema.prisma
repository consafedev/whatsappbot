generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformDeploymentMode {
  shared
  dedicated
  customer_hosted

  @@map("platform_deployment_mode")
}

enum DeploymentEnvironment {
  production
  staging
  development

  @@map("deployment_environment")
}

enum ReleaseChannel {
  stable
  candidate
  beta

  @@map("release_channel")
}

enum PlatformDeploymentStatus {
  healthy
  degraded
  offline
  maintenance

  @@map("platform_deployment_status")
}

enum TenantStatus {
  provisioning
  active
  suspended
  offboarding
  archived

  @@map("tenant_status")
}

enum TenantEntitlementSource {
  plan
  manual_override
  trial
  contract

  @@map("tenant_entitlement_source")
}

enum OrganizationUnitType {
  company
  branch
  department
  team
  other

  @@map("organization_unit_type")
}

model PlatformDeployment {
  id             String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  mode           PlatformDeploymentMode
  environment    DeploymentEnvironment
  currentVersion String                   @map("current_version")
  targetVersion  String?                  @map("target_version")
  releaseChannel ReleaseChannel           @map("release_channel")
  status         PlatformDeploymentStatus
  baseUrl        String?                  @map("base_url")
  metadata       Json?                    @db.JsonB
  lastHealthAt   DateTime?                @map("last_health_at") @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenants        Tenant[]

  @@map("platform_deployment")
}

model Tenant {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deploymentId      String?             @map("deployment_id") @db.Uuid
  legalName         String              @map("legal_name")
  displayName       String              @map("display_name")
  slug              String              @unique(map: "tenant_slug_key")
  status            TenantStatus
  defaultTimezone   String              @map("default_timezone")
  defaultLocale     String              @map("default_locale")
  defaultCurrency   String              @map("default_currency")
  brandingConfig    Json                @default("{}") @map("branding_config") @db.JsonB
  settings          Json                @default("{}") @db.JsonB
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  suspendedAt       DateTime?           @map("suspended_at") @db.Timestamptz(3)
  deployment        PlatformDeployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  entitlements      TenantEntitlement[]
  organizationUnits OrganizationUnit[]

  @@index([status], map: "tenant_status_idx")
  @@index([deploymentId], map: "tenant_deployment_id_idx")
  @@map("tenant")
}

model TenantEntitlement {
  id             String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                  @map("tenant_id") @db.Uuid
  entitlementKey String                  @map("entitlement_key")
  enabled        Boolean                 @default(false)
  limitValue     Decimal?                @map("limit_value") @db.Decimal(20, 4)
  config         Json                    @default("{}") @db.JsonB
  startsAt       DateTime?               @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?               @map("ends_at") @db.Timestamptz(3)
  source         TenantEntitlementSource
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, entitlementKey], map: "tenant_entitlement_tenant_key_key")
  @@index([tenantId], map: "tenant_entitlement_tenant_id_idx")
  @@map("tenant_entitlement")
}

model PlatformFeatureFlag {
  key             String   @id
  enabledGlobally Boolean  @default(false) @map("enabled_globally")
  rolloutConfig   Json     @default("{}") @map("rollout_config") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_feature_flag")
}

model OrganizationUnit {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  parentId        String?              @map("parent_id") @db.Uuid
  type            OrganizationUnitType
  name            String
  code            String?
  timezone        String?
  businessHoursId String?              @map("business_hours_id") @db.Uuid
  address         Json?                @db.JsonB
  settings        Json                 @default("{}") @db.JsonB
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent          OrganizationUnit?    @relation("OrganizationUnitHierarchy", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  children        OrganizationUnit[]   @relation("OrganizationUnitHierarchy")

  @@unique([tenantId, id], map: "organization_unit_tenant_id_id_key")
  @@index([tenantId], map: "organization_unit_tenant_id_idx")
  @@index([parentId], map: "organization_unit_parent_id_idx")
  @@index([tenantId, active], map: "organization_unit_tenant_active_idx")
  @@map("organization_unit")
}

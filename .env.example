# Development-only example values. Replace them in a local .env file.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001
WEB_PORT=3005
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
PLATFORM_WEB_ORIGIN=http://localhost:3005
TENANT_WEB_ORIGIN=http://localhost:3005

# Set these only for an explicit `pnpm platform-admin:create` invocation.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-15-character-minimum-passphrase
PLATFORM_ADMIN_BOOTSTRAP_DISPLAY_NAME=Platform Administrator
PLATFORM_ADMIN_BOOTSTRAP_LOCALE=es-MX
PLATFORM_ADMIN_BOOTSTRAP_TIMEZONE=America/Mexico_City

# Local Docker Compose database settings. These are fictitious placeholders.
POSTGRES_DB=whatsapp_platform_dev
POSTGRES_USER=whatsapp_platform_dev
POSTGRES_PASSWORD=replace-with-a-local-development-password
REDIS_PASSWORD=replace-with-a-local-development-password

# URLs used when running Node processes directly on the host.
DATABASE_URL=postgresql://whatsapp_platform_dev:replace-with-a-local-development-password@localhost:5432/whatsapp_platform_dev
REDIS_URL=redis://:replace-with-a-local-development-password@localhost:6379

# 32-byte AES-256-GCM key for tenant-owned messaging credentials, hexadecimal.
MESSAGING_CREDENTIALS_KEY=replace-with-64-hex-characters-before-using-credentials

# Separate scratch database used only by Prisma 7 shadow checks
# (`prisma migrate diff --exit-code` and `prisma migrate dev`).
# It must exist (e.g. created once with `CREATE DATABASE`), never holds
# runtime data, and uses the same pattern and placeholders as DATABASE_URL.
SHADOW_DATABASE_URL=postgresql://whatsapp_platform_dev:replace-with-a-local-development-password@localhost:5432/whatsapp_platform_dev_shadow
